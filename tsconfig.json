{
  "compilerOptions": {
    "target": "esnext",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["ESNext"],
    "types": ["node", "vitest/globals"],
    "noEmit": true, // emit is configured in tsconfig.build.json
    "rewriteRelativeImportExtensions": true, // import './foo.ts' emits './foo.js'

    "strict": true,
    "strictNullChecks": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "noImplicitReturns": true,
    "resolveJsonModule": true
  },
  "include": [
    "src",
    "tests",
    "*.config.ts"
  ]
}
